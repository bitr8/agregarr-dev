{
  "name": "agregarr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon -e ts --watch server --watch agregarr-api.yml -e .json,.ts,.yml -x ts-node -r tsconfig-paths/register --files --project server/tsconfig.json server/index.ts",
    "build:server": "tsc --project server/tsconfig.json && copyfiles -u 2 server/templates/**/*.{html,pug} dist/templates && tsc-alias -p server/tsconfig.json",
    "build:next": "next build",
    "build": "yarn build:next && yarn build:server",
    "lint": "eslint \"./server/**/*.{ts,tsx}\" \"./src/**/*.{ts,tsx}\"",
    "start": "NODE_ENV=production node dist/index.js",
    "i18n:check-duplicates": "node scripts/check-i18n-duplicates.js",
    "i18n:extract": "yarn i18n:check-duplicates && extract-messages -l=en -o src/i18n/locale -d en --flat true --overwriteDefault true \"./src/**/!(*.test).{ts,tsx}\"",
    "migration:generate": "ts-node -r tsconfig-paths/register --project server/tsconfig.json ./node_modules/typeorm/cli.js migration:generate -d server/datasource.ts",
    "migration:create": "ts-node -r tsconfig-paths/register --project server/tsconfig.json ./node_modules/typeorm/cli.js migration:create -d server/datasource.ts",
    "migration:run": "ts-node -r tsconfig-paths/register --project server/tsconfig.json ./node_modules/typeorm/cli.js migration:run -d server/datasource.ts",
    "format": "prettier --loglevel warn --write --cache .",
    "format:check": "prettier --check --cache .",
    "test": "vitest run",
    "typecheck": "yarn typecheck:server && yarn typecheck:client",
    "typecheck:server": "tsc --project server/tsconfig.json --noEmit",
    "typecheck:client": "tsc --noEmit",
    "prepare": "husky install",
    "cypress:open": "cypress open",
    "cypress:prepare": "ts-node -r tsconfig-paths/register --files --project server/tsconfig.json server/scripts/prepareTestDb.ts",
    "cypress:build": "yarn build && yarn cypress:prepare"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agregarr/agregarr.git"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formatjs/intl-displaynames": "6.8.13",
    "@formatjs/intl-locale": "3.4.6",
    "@formatjs/intl-pluralrules": "5.4.6",
    "@formatjs/intl-utils": "3.8.4",
    "@headlessui/react": "1.7.19",
    "@heroicons/react": "2.2.0",
    "@sidekickicons/react": "^0.15.0",
    "@supercharge/request-ip": "1.2.0",
    "@svgr/webpack": "6.5.1",
    "@tanem/react-nprogress": "5.0.63",
    "@types/jsdom": "^21.1.7",
    "@types/ua-parser-js": "0.7.36",
    "ace-builds": "1.45.2",
    "archiver": "^7.0.1",
    "axios": "1.21.0",
    "axios-cookiejar-support": "^6.0.5",
    "axios-rate-limit": "1.9.0",
    "bcrypt": "5.1.1",
    "bowser": "2.15.0",
    "canvas": "^3.2.3",
    "connect-typeorm": "1.1.4",
    "cookie-parser": "1.4.7",
    "copy-to-clipboard": "3.3.3",
    "cron-parser": "^5.10.2",
    "cronstrue": "2.59.0",
    "csurf": "1.11.0",
    "date-fns": "2.30.0",
    "dayjs": "1.11.23",
    "express": "4.22.3",
    "express-openapi-validator": "^5.6.2",
    "express-rate-limit": "6.11.2",
    "express-session": "1.19.0",
    "formik": "2.4.9",
    "gravatar-url": "3.1.0",
    "helmet": "^8.3.0",
    "intl": "1.2.5",
    "jsdom": "^26.1.0",
    "konva": "^9.3.14",
    "lodash": "4.18.1",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "next": "12.3.7",
    "node-cache": "5.1.2",
    "node-gyp": "9.4.1",
    "node-schedule": "2.1.2",
    "node-stream-zip": "^1.16.0",
    "playwright": "^1.64.1",
    "plex-api": "5.3.2",
    "react": "18.3.1",
    "react-ace": "10.1.0",
    "react-animate-height": "2.1.2",
    "react-aria": "3.53.1",
    "react-dom": "18.3.1",
    "react-intersection-observer": "9.16.0",
    "react-intl": "6.8.9",
